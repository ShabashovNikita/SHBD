<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SHBD" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/chompass_primary</item>
        <item name="android:colorPrimaryDark">@color/chompass_primary_dark</item>
        <item name="android:colorAccent">@color/chompass_accent</item>
        <item name="android:statusBarColor">@color/chompass_primary_dark</item>
        <item name="android:navigationBarColor">@color/chompass_surface</item>
        <item name="android:windowBackground">@color/chompass_background</item>
    </style>

    <style name="Theme.SHBD.Splash.Base" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.SHBD</item>
    </style>

    <style name="Theme.SHBD.Splash" parent="Theme.SHBD.Splash.Teal" />

    <style name="Theme.SHBD.Splash.Pink" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>

    <style name="Theme.SHBD.Splash.Red" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_red</item>
    </style>

    <style name="Theme.SHBD.Splash.Orange" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_orange</item>
    </style>

    <style name="Theme.SHBD.Splash.Green" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_green</item>
    </style>

    <style name="Theme.SHBD.Splash.Mint" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_mint</item>
    </style>

    <style name="Theme.SHBD.Splash.Teal" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_teal</item>
    </style>

    <style name="Theme.SHBD.Splash.Blue" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blue</item>
    </style>

    <style name="Theme.SHBD.Splash.Purple" parent="Theme.SHBD.Splash.Base">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_purple</item>
    </style>
</resources>
